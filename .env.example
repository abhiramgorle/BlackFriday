# Copy to .env for local runs. Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Optional second channel (free, no account): install the ntfy app, subscribe to a
# long random topic name, and put the same name here.
# NTFY_TOPIC=bf-deals-k3j9d8s7f6

# Only used by `python run.py loop` (Railway / any always-on host).
INTERVAL_SECONDS=1800
